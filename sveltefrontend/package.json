{
	"name": "sveltefrontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"ws": "bun run wsServer.ts",
		"dev:all": "bun run ws & bun run dev",
		"build": "vite build",
		"test": "vitest",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@sveltejs/kit": "^2.22.0",
		"@types/bun": "^1.2.20",
		"ioredis": "^5.7.0",
		"vitest": "^3.2.4",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"bun-types": "^1.2.20",
		"svelte": "^5.0.0",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	}
}
